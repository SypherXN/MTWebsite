---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SearchModal from "../components/SearchModal.astro";
import ConsentBanner from "../components/ConsentBanner.astro";
import site from "../data/site.json";
import { withBase } from "../utils/base";
import { absoluteUrl, defaultOgImage } from "../utils/seo";

interface Props {
  title?: string;
  description?: string;
  /** Site-root path or absolute URL for social preview image. */
  image?: string;
  type?: "website" | "article";
  noindex?: boolean;
  /** ISO date for article pages (maps to article:published_time). */
  articlePublishedTime?: string;
  /** JSON-LD object(s) serialized into a script tag. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = site.name,
  description = site.description,
  image,
  type = "website",
  noindex = false,
  articlePublishedTime,
  jsonLd,
} = Astro.props;

const pageTitle = title === site.name ? title : `${title} | ${site.name}`;
const siteUrl = Astro.site ?? new URL("https://matthewgtran.com");
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const ogImageURL = absoluteUrl(image ?? defaultOgImage(), siteUrl);
const plausibleEnabled = import.meta.env.PUBLIC_PLAUSIBLE_ENABLED === "true";
const ga4Enabled = import.meta.env.PUBLIC_GA4_ENABLED === "true";
const jsonLdPayload = jsonLd ? JSON.stringify(jsonLd) : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL.href} />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <link rel="apple-touch-icon" href={withBase("/favicon.svg")} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;600&family=Oswald:wght@500;600&display=swap"
    />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:alt" content={title === site.name ? `${site.name} — ${site.title}` : title} />
    {type === "article" && articlePublishedTime && (
      <meta property="article:published_time" content={articlePublishedTime} />
    )}
    {type === "article" && (
      <meta property="article:author" content={site.name} />
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={title === site.name ? `${site.name} — ${site.title}` : title} />

    {jsonLdPayload && (
      <script type="application/ld+json" set:html={jsonLdPayload} />
    )}

    <script is:inline>
      (function () {
        const stored = localStorage.getItem("theme");
        const prefersLight = window.matchMedia("(prefers-color-scheme: light)").matches;
        const theme = stored ?? (prefersLight ? "light" : "dark");
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    {plausibleEnabled && (
      <script defer data-domain={import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN} src="https://plausible.io/js/script.js" />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" data-pagefind-body data-pagefind-meta={`title: ${pageTitle}`}>
      <slot />
    </main>
    <Footer />
    <SearchModal />
    <ConsentBanner />
  </body>
</html>
