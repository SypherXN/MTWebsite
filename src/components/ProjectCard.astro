---
import type { CollectionEntry } from "astro:content";
import { withBase } from "../utils/base";

interface Props { project: CollectionEntry<"projects"> }
const { project } = Astro.props;
const { title, summary, image, tools } = project.data;
const href = withBase(`/projects/${project.id}/`);
const cover = withBase(image);
---
<a
  class:list={["project-card", { "project-card--featured": project.data.featured }]}
  href={href}
>
  <div class="project-card-media">
    <img
      class="project-card-media-img"
      src={cover}
      alt={title}
      loading="lazy"
      decoding="async"
      width="640"
      height="400"
    />
  </div>
  <div class="project-card-body">
    <h3>{title}</h3>
    <p>{summary}</p>
    <div class="chips">
      {tools.slice(0, 4).map((t) => <span class="chip">{t}</span>)}
    </div>
  </div>
</a>
