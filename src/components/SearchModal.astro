---
import { withBase } from "../utils/base";

const baseUrl = import.meta.env.BASE_URL;
const normalizedBase = baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`;
const pagefindCss = withBase("/pagefind/pagefind-ui.css");
const pagefindJs = withBase("/pagefind/pagefind-ui.js");
---
<div
  class="search-modal"
  id="search-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="search-modal-title"
  aria-hidden="true"
>
  <div class="search-panel">
    <div class="search-panel-header">
      <h2 class="search-panel-title" id="search-modal-title">Search site</h2>
      <button type="button" class="icon-btn" id="search-close" aria-label="Close search">Close</button>
    </div>
    <div id="pagefind-search" class="pagefind-ui"></div>
  </div>
</div>
<script define:vars={{ normalizedBase, pagefindCss, pagefindJs }}>
  const modal = document.getElementById("search-modal");
  const closeBtn = document.getElementById("search-close");
  let pagefindReady = false;
  let lastFocused = null;

  const getFocusable = () => {
    if (!modal) return [];
    return [...modal.querySelectorAll(
      'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])',
    )].filter((el) => !(el instanceof HTMLButtonElement && el.disabled));
  };

  const trapFocus = (e) => {
    if (e.key !== "Tab" || !modal?.classList.contains("open")) return;
    const focusable = getFocusable();
    if (!focusable.length) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  };

  const loadPagefindAssets = () => {
    if (pagefindReady) return Promise.resolve();
    return new Promise((resolve) => {
      if (!document.querySelector('link[data-mt-pagefind="true"]')) {
        const link = document.createElement("link");
        link.rel = "stylesheet";
        link.href = pagefindCss;
        link.setAttribute("data-mt-pagefind", "true");
        document.head.appendChild(link);
      }

      if (typeof PagefindUI !== "undefined") {
        pagefindReady = true;
        resolve();
        return;
      }

      const script = document.createElement("script");
      script.src = pagefindJs;
      script.onload = () => {
        pagefindReady = true;
        resolve();
      };
      document.head.appendChild(script);
    });
  };

  const initPagefind = () => {
    if (typeof PagefindUI === "undefined") return;
    if (document.getElementById("pagefind-search")?.dataset.initialized === "true") return;

    new PagefindUI({
      element: "#pagefind-search",
      baseUrl: normalizedBase,
      showSubResults: false,
      showImages: false,
      excerptLength: 40,
    });

    const root = document.getElementById("pagefind-search");
    if (root) root.dataset.initialized = "true";

    const searchInput = document.querySelector("#pagefind-search .pagefind-ui__search-input");
    if (searchInput instanceof HTMLInputElement) {
      searchInput.placeholder = "Search by project name, tools, or topic…";
    }
  };

  const openModal = async () => {
    if (!modal) return;
    lastFocused = document.activeElement;
    modal.classList.add("open");
    modal.setAttribute("aria-hidden", "false");
    document.body.classList.add("search-modal-open");
    await loadPagefindAssets();
    initPagefind();
    window.setTimeout(() => {
      const input = document.querySelector("#pagefind-search .pagefind-ui__search-input");
      if (input instanceof HTMLInputElement) input.focus();
      else closeBtn?.focus();
    }, 50);
  };

  const closeModal = () => {
    if (!modal) return;
    modal.classList.remove("open");
    modal.setAttribute("aria-hidden", "true");
    document.body.classList.remove("search-modal-open");
    if (lastFocused instanceof HTMLElement) lastFocused.focus();
  };

  window.addEventListener("mt-search-open", () => openModal());

  closeBtn?.addEventListener("click", closeModal);

  modal?.addEventListener("click", (e) => {
    if (e.target === e.currentTarget) closeModal();
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeModal();
    trapFocus(e);
  });

  modal?.addEventListener("click", (e) => {
    const link = e.target instanceof Element ? e.target.closest("a.pagefind-ui__result-link") : null;
    if (link) closeModal();
  });
</script>
