---
import { withBase } from "../utils/base";
---
<div class="search-modal" id="search-modal" role="dialog" aria-label="Search" aria-hidden="true">
  <div class="search-panel">
    <button type="button" class="icon-btn" id="search-close" style="margin-bottom:0.75rem">Close</button>
    <link href={withBase("/pagefind/pagefind-ui.css")} rel="stylesheet" />
    <div id="pagefind-search" class="pagefind-ui"></div>
  </div>
</div>
<script>
  document.getElementById("search-close")?.addEventListener("click", () => {
    document.getElementById("search-modal")?.classList.remove("open");
  });
  document.getElementById("search-modal")?.addEventListener("click", (e) => {
    if (e.target === e.currentTarget) e.currentTarget.classList.remove("open");
  });
</script>
<script is:inline src={withBase("/pagefind/pagefind-ui.js")}></script>
<script is:inline define:vars={{ baseUrl: import.meta.env.BASE_URL }}>
  window.addEventListener("DOMContentLoaded", () => {
    if (typeof PagefindUI !== "undefined") {
      new PagefindUI({ element: "#pagefind-search", showSubResults: true, baseUrl });
    }
  });
</script>