---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../utils/base";
---
<BaseLayout title="Page not found" noindex>
  <section class="section container" style="text-align:center">
    <h1 class="section-title">404</h1>
    <p>That page does not exist.</p>
    <p><a class="btn btn-primary" href={withBase("/")}>Home</a> <a class="btn btn-ghost" href={withBase("/projects/")}>Projects</a></p>
  </section>
</BaseLayout>