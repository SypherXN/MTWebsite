---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import site from "../data/site.json";
import { getSortedProjects } from "../utils/projects";
import { withBase } from "../utils/base";
import { personJsonLd, webSiteJsonLd } from "../utils/jsonld";

const projects = await getSortedProjects();
const featured = projects.filter((p) => p.data.featured).slice(0, 3);
const siteUrl = Astro.site ?? new URL("https://matthewgtran.com");
---
<BaseLayout description={site.description} image={site.image} jsonLd={[personJsonLd(siteUrl), webSiteJsonLd(siteUrl)]}>
  <section class="hero container">
    <div class="hero-photo-frame">
      <img
        class="hero-photo"
        src={withBase(site.image)}
        alt={site.name}
        width="320"
        height="320"
        loading="eager"
        decoding="async"
      />
    </div>
    <h1>{site.name}</h1>
    <p class="subtitle">{site.title} | {site.subtitle}</p>
    <p class="tagline">{site.tagline}</p>
    <div class="hero-ctas">
      <a class="btn btn-primary" href={withBase("/projects/")} data-ga-cta="view_projects">View Projects</a>
      <a class="btn btn-ghost" href={withBase("/resume/")} data-ga-cta="resume">Resume</a>
      <a class="btn btn-ghost" href={withBase("/about/")} data-ga-cta="about">About</a>
    </div>
  </section>

  <section class="section container">
    <h2 class="section-title">Featured work</h2>
    <div class="project-grid">
      {featured.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>
</BaseLayout>
