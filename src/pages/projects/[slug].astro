---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectDetails from "../../components/ProjectDetails.astro";
import YouTubeFacade from "../../components/YouTubeFacade.astro";
import { getCollection, render } from "astro:content";
import { creativeWorkJsonLd } from "../../utils/jsonld";
import { withBase } from "../../utils/base";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, overview, image, youtube, category, role, dates, genre, platform, tools, links, startDate } =
  project.data;
const overviewText = overview ?? summary;
const heroImage = withBase(image);
const siteUrl = Astro.site ?? new URL("https://matthewgtran.com");
const pageUrl = new URL(Astro.url.pathname, siteUrl);
const articlePublishedTime = startDate ? `${startDate}T00:00:00.000Z` : undefined;
---
<BaseLayout
  title={title}
  description={summary}
  image={image}
  type="article"
  articlePublishedTime={articlePublishedTime}
  jsonLd={creativeWorkJsonLd(project, pageUrl, siteUrl)}
>
  <article class="section container prose">
    {youtube ? (
      <YouTubeFacade url={youtube} title={title} />
    ) : (
      <div class="case-hero-media">
        <img src={heroImage} alt={title} width="1280" height="720" loading="eager" decoding="async" />
      </div>
    )}
    <h1>{title}</h1>
    <h2>Overview</h2>
    {overviewText.split(/\n\n+/).map((paragraph) => (
      <p>{paragraph.trim()}</p>
    ))}
    <ProjectDetails
      category={category}
      role={role}
      dates={dates}
      genre={genre}
      platform={platform}
      tools={tools}
      links={links}
    />
    <Content />
  </article>
</BaseLayout>
