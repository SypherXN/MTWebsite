---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getProjectsByCategory } from "../../utils/projects";

const groups = await getProjectsByCategory();
---
<BaseLayout title="Projects" description="Game development, design, and computer science projects by Matthew Tran.">
  <section class="section container">
    <h1 class="section-title">Projects</h1>
    {groups.map(({ category, projects }) => (
      <div class="category-block">
        <h2 class="section-title" style="font-size:1.5rem">{category}</h2>
        <div class="project-grid">
          {projects.map((p) => <ProjectCard project={p} />)}
        </div>
      </div>
    ))}
  </section>
</BaseLayout>